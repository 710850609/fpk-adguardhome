#!/bin/bash

### This script is called after the user installs the application.

LOG_FILE="${TRIM_PKGVAR}/info.log"
DEFAULT_CFG_FILE="${TRIM_APPDEST}/bin/AdGuardHome.yaml"
CFG_FILE="${TRIM_PKGVAR}/AdGuardHome.yaml"
SCRIPT_PATH="${TRIM_APPDEST}/script"
USER_FILTER_PATH="${TRIM_PKGVAR}/userfilters"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

encrypt_password() {
    # python 脚本只输出哈希；stderr 进日志
    "$SCRIPT_PATH/.venv/bin/python3" "${SCRIPT_PATH}/htpasswd.py" "$1" 2>> ${LOG_FILE} 2>&1
}

set_yaml() {
    # Usage: ./yaml_set.py 'key.path' 'value' file.yaml
    "$SCRIPT_PATH/.venv/bin/python3" "${SCRIPT_PATH}/yaml_set.py" "$1" "$2" "$3" 2>> ${LOG_FILE} 2>&1
}


log_msg "install_callback脚本执行中..."

# 旧数据清理
update_cfg="false"
if [ "${adg_coverage_config}" == "true" ]; then
    bash -c "rm -rf ${TRIM_PKGVAR}" >> ${LOG_FILE} 2>&1
    log_msg "安装时，用户选择 覆盖已有配置，清理已有配置"
    update_cfg="true"
fi

mkdir -p "${TRIM_PKGVAR}"
log_msg "创建目标路径：${TRIM_PKGVAR}"

# 安装脚本
log_msg "创建虚拟环境"
bash -c "/usr/bin/python3 -m venv ${SCRIPT_PATH}/.venv" >> ${LOG_FILE} 2>&1
log_msg "安装离线依赖"
bash -c "${SCRIPT_PATH}/.venv/bin/pip install --no-index --find-links=${SCRIPT_PATH}/wheels -r ${SCRIPT_PATH}/requirements.txt" >> ${LOG_FILE} 2>&1


# 设置运行配置
if [ ! -f "${CFG_FILE}" ]; then
    log_msg "不存在配置文件，拷贝默认配置"
    bash -c "cp -f ${DEFAULT_CFG_FILE} ${CFG_FILE}" >> ${LOG_FILE} 2>&1
    update_cfg="true"
else
    log_msg "已存在配置文件，跳过设置配置"
fi

log_msg "创建用户自定义目录"
mkdir -p "${USER_FILTER_PATH}"
if [[ "${adg_setting_type}" == "inner" && "${update_cfg}" == "true" ]]; then
    log_msg "安装时，用户选择配置: ${adg_setting_type}"
    log_msg "设置upstream_dns"
    set_yaml "dns.upstream_dns" "[]" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[0]" "'# 国内主用'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[1]" "'[/*.cn/]https://dns.alidns.com/dns-query'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[2]" "'[/*.qq.com/]https://dns.alidns.com/dns-query'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[3]" "'[/*.bilibili.com/]https://dns.alidns.com/dns-query'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[4]" "'# 微软/Steam 香港节点'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[5]" "'[/*.microsoft.com/]https://dns.alidns.com/dns-query'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[6]" "'[/steamcommunity.com/]https://dns.alidns.com/dns-query'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[7]" "'# 纯海外 CDN'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[8]" "'[/*.cloudfront.net/]https://dns.cloudflare.com/dns-query'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[9]" "'[/*.akamaihd.net/]https://dns.cloudflare.com/dns-query'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[10]" "'# 默认兜底 →  DoH'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[11]" "https://dns.alidns.com/dns-query" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[12]" "https://doh.pub/dns-query" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[13]" "https://dns.cloudflare.com/dns-query" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[14]" "'# 兜底纯 UDP(断网也能解析)'" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[15]" "223.5.5.5" "${CFG_FILE}"
    set_yaml "dns.upstream_dns[16]" "2400:3200::1" "${CFG_FILE}"

    log_msg "设置bootstrap_dns"
    set_yaml "dns.bootstrap_dns" "[]" "${CFG_FILE}"
    set_yaml "dns.bootstrap_dns[0]" "223.5.5.5" "${CFG_FILE}"
    set_yaml "dns.bootstrap_dns[1]" "119.29.29.29" "${CFG_FILE}"
    set_yaml "dns.bootstrap_dns[2]" "2400:3200::1" "${CFG_FILE}"
    set_yaml "dns.bootstrap_dns[3]" "'2402:4e00::'" "${CFG_FILE}"
    set_yaml "dns.bootstrap_dns[4]" "2001:dc7:1000::1" "${CFG_FILE}"

    log_msg "设置upstream_mode"
    set_yaml "dns.upstream_mode" "parallel" "${CFG_FILE}"

    log_msg "设置upstream_timeout"
    set_yaml "dns.upstream_timeout" "5s" "${CFG_FILE}"

    log_msg "设置cache_ttl_min"
    set_yaml "dns.cache_ttl_min" "300" "${CFG_FILE}"

    log_msg "设置cache_ttl_max"
    set_yaml "dns.cache_ttl_max" "86400" "${CFG_FILE}"

    log_msg "创建用户自定义白名单文件"
    touch "${USER_FILTER_PATH}/dns-whitelist.txt"
    set_yaml "whitelist_filters" "[]" "${CFG_FILE}"
    set_yaml "whitelist_filters[0].id" "1" "${CFG_FILE}"
    set_yaml "whitelist_filters[0].enabled" "true" "${CFG_FILE}"
    set_yaml "whitelist_filters[0].name" "本地白名单" "${CFG_FILE}"
    set_yaml "whitelist_filters[0].url" "${USER_FILTER_PATH}/dns-whitelist.txt" "${CFG_FILE}"

    log_msg "创建用户自定义黑名单文件"
    touch "${USER_FILTER_PATH}/dns-balcklist.txt"

    log_msg "设置filters"
    set_yaml "filters" "[]" "${CFG_FILE}"
    set_yaml "filters[0].id" "5" "${CFG_FILE}"
    set_yaml "filters[0].enabled" "true" "${CFG_FILE}"
    set_yaml "filters[0].name" "本地黑名单" "${CFG_FILE}"
    set_yaml "filters[0].url" "${USER_FILTER_PATH}/dns-balcklist.txt" "${CFG_FILE}"
    set_yaml "filters[1].id" "4" "${CFG_FILE}"
    set_yaml "filters[1].enabled" "true" "${CFG_FILE}"
    set_yaml "filters[1].name" "大全版本" "${CFG_FILE}"
    set_yaml "filters[1].url" "https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblockdns.txt" "${CFG_FILE}"
    set_yaml "filters[2].id" "3" "${CFG_FILE}"
    set_yaml "filters[2].enabled" "true" "${CFG_FILE}"
    set_yaml "filters[2].name" "国内视频/APP广告" "${CFG_FILE}"
    set_yaml "filters[2].url" "https://anti-ad.net/adguard.txt" "${CFG_FILE}"
    set_yaml "filters[3].id" "2" "${CFG_FILE}"
    set_yaml "filters[3].enabled" "false" "${CFG_FILE}"
    set_yaml "filters[3].name" "AdAway Default Blocklist" "${CFG_FILE}"
    set_yaml "filters[3].url" "https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt" "${CFG_FILE}"
    set_yaml "filters[4].id" "1" "${CFG_FILE}"
    set_yaml "filters[4].enabled" "false" "${CFG_FILE}"
    set_yaml "filters[4].name" "AdGuard DNS filter" "${CFG_FILE}"
    set_yaml "filters[4].url" "https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt" "${CFG_FILE}"

    log_msg "增加自定义放行指定IP写法"
    set_yaml "user_rules" "[]" "${CFG_FILE}"
    set_yaml "user_rules[0]" "'# 放行指定IP写法参考: 如放行192.168.1.1'" "${CFG_FILE}"
    set_yaml "user_rules[1]" "'# @@||*.*^\$client='192.168.1.1'" "${CFG_FILE}"

    # 设置自定义过滤
    log_msg "设置自定义过滤: ${USER_FILTER_PATH}/*"
    set_yaml "filtering.safe_fs_patterns[0]" "${USER_FILTER_PATH}/*" "${CFG_FILE}"
fi

# 设置管理员账号
if [[ "${update_cfg}" == "true" ]]; then
    log_msg "设置管理员账号: ${adg_admin_name}"
    set_yaml "users[0].name" "${adg_admin_name}" "${CFG_FILE}"
fi

# 设置管理员密码
if [[ "${update_cfg}" == "true" ]]; then
    password=$(encrypt_password "${adg_admin_password}")
    log_msg "设置管理员密码: ${adg_admin_password}"
    set_yaml "users[0].password" "${password}" "${CFG_FILE}"
fi

# 设置管理服务端口
if [[ "${update_cfg}" == "true" ]]; then
    log_msg "设置管理服务端口: ${adg_mgr_port}"
    set_yaml "http.address" "0.0.0.0:${adg_mgr_port}" "${CFG_FILE}"
fi

# 设置DNS服务端口
if [[ "${update_cfg}" == "true" ]]; then
    log_msg "设置DNS服务端口: ${adg_dns_port}"
    set_yaml "dns.port" "${adg_dns_port}" "${CFG_FILE}"
fi

exit 0