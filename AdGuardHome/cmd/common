#!/bin/bash

LOG_DIR="${TRIM_APPDEST_VOL}/@appshare/${TRIM_APPNAME}/logs"
LOG_FILE="${LOG_DIR}/cmd.log"
SCRIPT_PATH="${TRIM_APPDEST}/script"
CFG_FILE="${TRIM_PKGVAR}/AdGuardHome.yaml"

log_msg() {
    if [ ! -d "${LOG_DIR}" ]; then
        mkdir -p "${LOG_DIR}"
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

alarm_and_exit() {
    # 在应用启动、安装、更新等过程中遇到错误时，可以向 TRIM_TEMP_LOGFILE 写入错误信息，然后退出脚本并返回错误码 1
    # 系统会自动将错误日志在前端展示为用户可见的内容（Dialog对话框形式）
    log_msg "$1"
    echo "$1" > "${TRIM_TEMP_LOGFILE}"
    exit 1
}

encrypt_password() {
    # python 脚本只输出哈希；stderr 进日志
    local error_msg result 
    result=$("$SCRIPT_PATH/.venv/bin/python3" "${SCRIPT_PATH}/htpasswd.py" "$1" 2>&1) || { 
        error_msg="$result"
        log_msg "脚本执行失败: $error_msg"
        alarm_and_exit "设置配置【$1】失败: $error_msg" 
    }
    echo "$result"
}

set_yaml() {
    # Usage: ./yaml_set.py 'key.path' 'value' file.yaml   
    error_msg=$("$SCRIPT_PATH/.venv/bin/python3" "${SCRIPT_PATH}/yaml_set.py" "$1" "$2" "$3" 2>&1) || { 
        log_msg "脚本执行失败: $error_msg"
        alarm_and_exit "设置配置【$1】失败: $error_msg" 
    }
}

get_yaml() {
    local file="$1" key="$2"
    local error_msg result    # ← 都声明为 local
  
    result=$("$SCRIPT_PATH/.venv/bin/python3" "${SCRIPT_PATH}/yaml_get.py" "$key" "$file" 2>&1) || { 
        error_msg="$result"     # ← 失败时才把结果当错误信息
        log_msg "脚本执行失败: $error_msg"
        alarm_and_exit "获取配置【$key】失败: $error_msg" 
    }
    echo "$result"
}

str_trim() {
    local str="$1"
    str="${str#"${str%%[![:space:]]*}"}"   # 去除首空格
    str="${str%"${str##*[![:space:]]}"}"  # 去除尾空格
    echo "$str"
}

check_port_in_use() {
    local port=$1
    local exclude_process=$2
    # Linux 用 ss，没有 ss 再用 netstat
    if command -v ss >/dev/null 2>&1; then
        if [ -n "$exclude_process" ]; then
            ss -tlnp | grep -q ":$port " | grep -v "$exclude_process"
        else
            ss -tln | grep -q ":$port "
        fi
    elif command -v netstat >/dev/null 2>&1; then
        if [ -n "$exclude_process" ]; then
            netstat -tlnp | grep -q ":$port " | grep -v "$exclude_process"
        else
            netstat -tln | grep -q ":$port "
        fi
    else
        # 都检测不到就保守一点：当“未占用”继续往下走
        return 1
    fi
}
